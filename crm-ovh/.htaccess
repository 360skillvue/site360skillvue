# Sécurité du dossier du CRM
Options -Indexes
DirectoryIndex index.php

# En-têtes de sécurité : HTTPS imposé pendant un an, version de PHP masquée
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header always unset X-Powered-By
  Header unset X-Powered-By
</IfModule>

# Pas de compression HTTP pour les pages et les réponses de l'API (attaque BREACH) ; les fichiers statiques
# (assets/) restent compressés, ils ne contiennent aucun secret.
<IfModule mod_setenvif.c>
  SetEnvIf Request_URI "^/(?!assets/)" no-gzip=1 dont-vary=1
</IfModule>

# Forcer HTTPS
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Connexion de Claude (OAuth) : adresses standard de découverte
RewriteRule ^\.well-known/oauth-protected-resource(/.*)?$ oauth.php?meta=protected-resource [L,QSA]
RewriteRule ^\.well-known/(oauth-authorization-server|openid-configuration)(/.*)?$ oauth.php?meta=authorization-server [L,QSA]
# Le jeton de Claude doit arriver jusqu'à PHP
RewriteCond %{HTTP:Authorization} .
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

# Fichiers jamais accessibles depuis le web
RewriteRule ^(lib|tests)(/|$) - [F,L]
<FilesMatch "^(config\.php|config\.sample\.php|cron\.php|.*\.md|\.htaccess|\.gitignore)$">
  Require all denied
</FilesMatch>
